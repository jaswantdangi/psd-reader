/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* No `outDir`, matching tsconfig.app.json. An outDir makes TypeScript infer
       rootDir as app/, which then rejects the engine at ../src as "not under
       rootDir". Nothing emits from this config anyway — Angular's application
       builder bundles workers through esbuild. */
    "lib": ["es2018", "webworker"],
    "types": []
  },
  "include": ["src/**/*.worker.ts"]
}
