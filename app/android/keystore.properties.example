# Copy to `keystore.properties` (gitignored) and fill in.
#
# Make the key ONCE and back it up somewhere you will still have in five years:
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# This is the one credential in the project that cannot be replaced by making a
# new one. Lose it and Google Play will never accept another build of
# com.digitaaz.psdeditor from anyone, including you.
#
# Paths are relative to android/.

storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
