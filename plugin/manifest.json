{
  "manifestVersion": 5,
  "id": "com.psdreader.sync",
  "name": "PSD Reader Sync",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "syncPanel",
      "label": {
        "default": "PSD Reader Sync"
      },
      "minimumSize": { "width": 230, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 320, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "wss://psd-sync-relay.jaswantdangi00.workers.dev",
        "https://psd-sync-relay.jaswantdangi00.workers.dev"
      ]
    },
    "clipboard": "readAndWrite"
  }
}
